# Copy this file to .env and fill in real values for production.
# (This project doesn't read .env automatically -- use something like
# `django-environ` or `python-dotenv`, or export these in your
# hosting platform's environment variables settings, or in your
# systemd/Docker service definition.)

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
SITE_DOMAIN=example.com

# --- Database (Postgres in production; omit this to use SQLite) ---
DATABASE_URL=postgres://kazeb_user:password@localhost:5432/kazeb

# --- Email (omit these to just print emails to the console) ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_USE_TLS=True
[email protected]

# --- SMS / phone verification (omit to fall back to emailed/console codes) ---
# SMS_BACKEND=trust.sms.AfricasTalkingSMSBackend
# SMS_API_KEY=your-africas-talking-or-twilio-api-key
# SMS_SENDER_ID=KazeBridge

# --- Error tracking (omit to disable) ---
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- HTTPS (only read when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
